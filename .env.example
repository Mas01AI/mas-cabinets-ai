# Mas Cabinets AI Agent — example configuration.
# Copy to ".env" and fill in. Never commit a real .env file.
# Every value is optional: with nothing set, the agent runs in dry-run mode.

# HubSpot private-app access token (portal "MAS Remodeling and Construction").
# Leave blank to run HubSpot in dry-run mode (nothing is pushed).
HUBSPOT_ACCESS_TOKEN=

# Work email used as the sender for follow-up drafts.
WORK_EMAIL=mseeriram@aol.com

# Optional: reserved for future AI personalisation of follow-up messages.
OPENAI_API_KEY=

# Optional: HubSpot portal ID (defaults to 247703427).
MAS_HUBSPOT_PORTAL_ID=247703427
